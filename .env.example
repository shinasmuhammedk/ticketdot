# PostgreSQL database connection URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/BusTicket?sslmode=disable

# JWT signing secret (minimum 32 characters in production/non-development)
JWT_SECRET=super-secret-key-change-this-to-a-very-long-32-chars-string

# HTTP server port
PORT=8080

# Application environment (development, staging, production). When set to "development", test endpoints and placeholder secrets are permitted.
APP_ENV=development

# Razorpay key identifier for payment order creation and client checkout
RAZORPAY_KEY_ID=rzp_test_exampleKey123

# Razorpay secret key used to compute and verify HMAC-SHA256 payment signatures
RAZORPAY_KEY_SECRET=exampleSecretKey123456

# Webhook signature secret used to authenticate inbound Razorpay webhook events
PAYMENT_WEBHOOK_SECRET=exampleWebhookSecret123456

# Payment gateway provider: 'razorpay' (default) or 'fake' (only permitted in APP_ENV=development)
PAYMENT_GATEWAY=razorpay

# Payment completion window in minutes before seat locks expire (default: 12)
PAYMENT_WINDOW_MINUTES=12

# Comma-separated list of allowed CORS origins (defaults to localhost:5173,localhost:5174 in development)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Rate limit for login endpoint in requests per 15 minutes per IP + email (default: 10)
LOGIN_RATE_LIMIT=10

# Rate limit for signup endpoint in requests per hour per IP (default: 10)
SIGNUP_RATE_LIMIT=10

# Rate limit for forgot-password endpoint in requests per hour per IP + email (default: 5)
FORGOT_PASSWORD_RATE_LIMIT=5

# Rate limit for general API endpoints in requests per minute per IP (default: 120)
GLOBAL_RATE_LIMIT=120

# Set to "true" only when running behind a trusted reverse proxy to respect X-Forwarded-For headers (default: false)
TRUST_PROXY=false

# Maximum allowed HTTP request payload size in bytes (default: 1048576 = 1MB)
MAX_BODY_BYTES=1048576

# Rate limit for payment verification endpoint in requests per minute per authenticated user (default: 10)
RATE_LIMIT_PAYMENT_VERIFY_PER_MIN=10
